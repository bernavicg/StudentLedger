# Dependencies
node_modules/
# The bun.lock generated here uses a lockfile version newer than some CI
# images; CI installs resolve fresh from package.json instead.
bun.lock
bun.lockb
# npm lockfiles generated via `bun x npm` on Windows come out mangled
# (missing optional platform deps/integrity), breaking clean installs.
package-lock.json
npm-shrinkwrap.json
yarn.lock

# Build output (rebuilt on the host at deploy time)
dist/

# Local env & secrets — NEVER commit these
.env
.env.local
.env.*.local
*.pem
jwks.tmp.json
jwt_private.tmp.txt

# Convex local
.convex/
*_generated.local

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Freebuff local runtime state
.freebuff/

# Misc
*.log
npm-debug.log*
